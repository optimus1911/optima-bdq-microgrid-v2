# Copy to .env and set the public DNS name for the TLS certificate.
PUBLIC_HOST=optima.example.test

# The gateway is loopback-only unless an operator explicitly selects a
# private interface reachable only by the approved upstream gateway.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8443

# External, protected files. Never put credential or private-key contents here.
BASIC_AUTH_FILE=./deploy/secrets/htpasswd
TLS_CERT_FILE=./deploy/secrets/fullchain.pem
TLS_KEY_FILE=./deploy/secrets/privkey.pem
